# Secrets only. mise loads this file into the environment; the dev tasks pass
# the stack's addresses at runtime, so no ports live here. `.env` is gitignored.

# Box API app token used by the Box integration.
BOX_APP_TOKEN=

# Box folder to ingest from.
BOX_FOLDER_ID=

# `DATABASE_URL` is deliberately absent: the dev tasks read Postgres's published
# host port from Podman and inject the connection string into the app.
